## DATABASE_URL="postgresql://eventflowapp:eventflow_password@localhost:5432/eventflowapp?schema=public"



# Copy any of these into .env to override the defaults used by docker-compose.yaml

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Alert e-mails (Grafana-managed alerts). Default SMTP = bundled MailHog (UI http://localhost:8025) ----
ALERT_EMAIL_TO=shimdi247@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chimdi247@gmail.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=grafana-alerts@eventflow.com
SMTP_STARTTLS_POLICY=MandatoryStartTLS      # real SMTP (e.g. smtp.gmail.com:587): MandatoryStartTLS

# ---- S3 storage for Mimir / Loki / Tempo (default: bundled MinIO) ----
S3_ENDPOINT=minio:9000               # AWS: s3.<region>.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_INSECURE=true                     # AWS: false
MIMIR_BLOCKS_BUCKET=mimir-blocks
MIMIR_RULER_BUCKET=mimir-ruler
LOKI_CHUNKS_BUCKET=loki-chunks
LOKI_RULER_BUCKET=loki-ruler
TEMPO_BUCKET=tempo-traces

# ---- Tracing ----
OTEL_TRACES_SAMPLER=parentbased_always_on   # prod: parentbased_traceidratio (+ OTEL_TRACES_SAMPLER_ARG=0.1)

# ---- Gateway rate limiting (a browser client issues many calls per page view, so the defaults are generous) ----
THROTTLE_LIMIT=300
THROTTLE_LOGIN_LIMIT=20
THROTTLE_REGISTER_LIMIT=10
CORS_ORIGINS=http://136.65.129.38:4000,http://127.0.0.1:4000

# ---- App e-mails (welcome, ticket confirmation, cancellations) sent by notifications-service ----
# Default (nothing set) = bundled MailHog at http://localhost:8025. For real inboxes via Gmail
# (needs 2-step verification + an app password: https://myaccount.google.com/apppasswords):

APP_SMTP_HOST=smtp.gmail.com
APP_SMTP_PORT=587
APP_SMTP_REQUIRE_TLS=true
APP_SMTP_USER=chimdi247@gmail.com
APP_SMTP_PASSWORD=
APP_SMTP_FROM="EventFlow <chimdi247@gmail.com>"

# ---- Stripe payments (payments-service) ----
# Keys: https://dashboard.stripe.com/test/apikeys   Webhook secret: printed by `stripe listen --events ... --forward-to ...` (local)
# or shown on the webhook endpoint in the Stripe dashboard. Without a key, FREE events still work and
# paid events answer "Payments are not configured".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Public URL of the web client: Stripe redirects the browser here after paying (e.g. http://<vm-ip>:4000)
CLIENT_URL=http://136.65.129.38:4000
PENDING_TICKET_TTL_MINUTES=30
