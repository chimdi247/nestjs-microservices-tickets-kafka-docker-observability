    {
      "id": 2,
      "type": "stat",
      "title": "Replication lag",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "max(pgx_replication_lag_seconds{job=\"postgres-replica\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "description": "Replay lag of the hot standby (0 when caught up).",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
