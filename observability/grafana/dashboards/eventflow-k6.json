    {
      "id": 13,
      "type": "timeseries",
      "title": "Container CPU % of limit while testing",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "100 * sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"eventflowapp-(api-gateway|auth-service|events-service|tickets-service|notifications-service)\"}[$__rate_interval])) / ((sum by (name) (container_spec_cpu_quota{name=~\"eventflowapp-(api-gateway|auth-service|events-service|tickets-service|notifications-service)\"}) / sum by (name) (container_spec_cpu_period{name=~\"eventflowapp-(api-gateway|auth-service|events-service|tickets-service|notifications-service)\"})) > 0)",
          "legendFormat": "{{name}}",
          "range": true
        }
      ],
